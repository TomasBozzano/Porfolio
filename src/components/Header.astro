---
import Lang from "./Lang.astro";
import ThemeToggle from "./ThemeToggle.astro";
import data from "../utils/data.json";
---

<header
  class="fixed top-0 z-10 flex items-center justify-center w-full mx-auto mt-2"
>
  <nav
    class="flex px-3 text-sm font-medium rounded-full
         text-gray-600 dark:text-gray-200
         justify-center items-center"
    id="main-nav"
  >
    <div id="lang-container" class="flex"></div>
    <ThemeToggle />
    <Lang />
  </nav>
</header>
<script define:vars={{ data }}>
  document.addEventListener("astro:page-load", () => {
    const sections = document.querySelectorAll("section");
    const navItems = document.querySelectorAll("header nav a");

    const callback = (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          navItems.forEach((item) => {
            if (item.getAttribute("aria-label") == entry.target.id) {
              item.classList.add("text-yellow-500");
            } else {
              item.classList.remove("text-yellow-500");
            }
          });
        }
      });
    };

    const observer = new IntersectionObserver(callback, {
      root: null,
      rootMargin: "0px",
      threshold: 0.3,
    });

    sections.forEach((section) => {
      observer.observe(section);
    });

    // Cleanup function
    document.onvisibilitychange = () => {
      if (document.visibilityState === "hidden") {
        observer.disconnect();
      } else {
        sections.forEach((section) => {
          observer.observe(section);
        });
      }
    };
  });

  const nav = document.getElementById("main-nav");

  if (nav) {
    window.addEventListener("scroll", () => {
      nav.classList.toggle("scrolled", window.scrollY > 50);
    });
  }

  function renderNav() {
    const lang = document.documentElement.lang.toUpperCase();

    const navItems = data[lang].nav;

    const navContainer = document.querySelector("#lang-container");

    navContainer.classList.remove("lang-fade-in");
    navContainer.classList.add("lang-fade-out");

    window.setTimeout(() => {
      navContainer.innerHTML = "";

      navItems.forEach((item) => {
        if (item.url == null) return;
        const a = document.createElement("a");
        a.href = item.url;
        a.textContent = item.title;
        a.setAttribute("aria-label", item.label);
        a.className =
          "sm:block transition-colors dark:text-white hover:text-cyan-500 hover:cyan-500 dark:hover:text-cyan-500 font-semibold relative block px-2 py-2";
        navContainer.appendChild(a);
      });

      requestAnimationFrame(() => {
        navContainer.classList.remove("lang-fade-out");
        navContainer.classList.add("lang-fade-in");
      });
    }, 180);
  }

  renderNav();
  window.addEventListener("language-change", renderNav);
</script>
<style>
  #main-nav {
    transition:
      background-color 200ms ease,
      box-shadow 200ms ease,
      backdrop-filter 200ms ease;
  }

  #main-nav.scrolled {
    box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1);
    backdrop-filter: blur(12px);
    background-color: rgb(0, 184, 219, 0.3);
    border: 1px solid rgb(255 255 255 / 0.1);
  }

  :global(.dark) #main-nav.scrolled {
    background-color: rgb(0, 184, 219, 0.3);
  }
</style>
