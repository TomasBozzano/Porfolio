---
import "../styles/global.css";
import Layout from '../layouts/Layout.astro';
import Presentacion from '../components/Presentacion.astro';
import Experience from '../components/Experience.astro';
import Certificate from '../components/Certificate.astro';
import About from '../components/About.astro';
import Habilities from '../components/Habilities.astro';
---

<Layout title="Portfolio Tomás Bozzano - Desarrollador, Programador y Analista de sistemas"
		description="Contrata a Tomás para crear tu aplicación web. Especializado en crear aplicaciones unicas"
		keywords="Desarrollador web, programador, analista de sistemas, aplicaciones web, aplicaciones unicas, aplicaciones a medida, desarrollador freelance, desarrollador independiente">
	<main class="min-h-screen">
		<section class="w-full mx-auto max-w-[60ch] px-6 content-center container py-20">
			<Presentacion />
		</section>
		<section>
			<Experience />
		</section>
		<section>
			<Habilities />
		</section>
		<section>
			<Certificate />
		</section>
		<section>
			<About />
		</section>
	</main>
</Layout>