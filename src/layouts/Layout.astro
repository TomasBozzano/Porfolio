---
import Header from "../components/Header.astro";
import data from "../utils/data.json";

interface Props {
  title: string;
  description: string;
  keywords?: string;
}

const { title, description, keywords } = Astro.props;
---

<!doctype html>
<html lang="es" class="">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/certificate.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="dark:bg-slate-900 bg-slate-50">
    <div id="page-root">
      <Header />
      <slot />
      <footer class="py-12 text-center dark:text-white" id="footer"></footer>
    </div>
    <div id="lang-transition" aria-hidden="true"></div>
  </body>
</html>
<script define:vars={{ data }}>
  function render() {
    const footer = document.getElementById("footer");
    const lang = document.documentElement.lang.toUpperCase();
    footer.textContent = data[lang].footer;
  }

  function runPageTransition() {
    const body = document.body;
    body.classList.add("lang-transition");
    window.setTimeout(() => {
      body.classList.remove("lang-transition");
    }, 260);
  }

  render();
  window.addEventListener("language-change", () => {
    // runPageTransition();
    render();
  });
</script>
<style is:global>
  /* =========================
     GENERAL
     ========================= */

  html {
    scroll-behavior: smooth;
  }

  body {
    scroll-behavior: smooth;
  }


  /* =========================
     HEADER / NAV
     ========================= */

  #header-nav {
    animation: nav-scroll linear both 0.5s;
    animation-timeline: scroll();
    animation-range: 0 500px;
  }


  /* =========================
     LIGHT MODE
     ========================= */

  @keyframes nav-scroll {
    to {
      backdrop-filter: blur(20px);
      background-color: rgb(229 229 229 / 80%);
      border: 1px solid rgb(0 0 0 / 10%);
      border-radius: 9999px;
      box-shadow:
        0 5px 30px -10px rgb(0 0 0 / 15%);
    }
  }


  /* =========================
     DARK MODE
     ========================= */

  :global(.dark) #header-nav {
    animation-name: nav-scroll-dark;
  }

  @keyframes nav-scroll-dark {
    to {
      backdrop-filter: blur(20px);
      background-color: rgb(15 23 42 / 80%);
      border: 1px solid rgb(255 255 255 / 10%);
      border-radius: 9999px;
      box-shadow:
        0 5px 30px -10px rgb(0 0 0 / 30%);
    }
  }


  /* =========================
     ACCESIBILIDAD
     ========================= */

  @media (prefers-reduced-motion: reduce) {
    html,
    body {
      scroll-behavior: auto;
    }

    #header-nav {
      animation: none;
    }
  }
</style>